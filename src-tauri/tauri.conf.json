{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Textdoc",
  "version": "0.2.2",
  "identifier": "com.textdoc.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix upgrade run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix upgrade run build",
    "frontendDist": "../upgrade/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Textdoc",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
