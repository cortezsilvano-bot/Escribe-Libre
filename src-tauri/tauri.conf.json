{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Escribe Libre",
  "version": "0.2.2",
  "identifier": "com.escribelibre.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix upgrade run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix upgrade run build",
    "frontendDist": "../upgrade/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Escribe Libre",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "A focused local document editor",
    "longDescription": "Escribe Libre is a private, focused document editor with rich text editing and local export tools.",
    "publisher": "Escribe Libre",
    "copyright": "Copyright (c) 2026 Escribe Libre",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "startMenuFolder": "Escribe Libre"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
