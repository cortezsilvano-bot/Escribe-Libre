{
  "name": "escribe-libre",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run build",
    "verify:env": "node scripts/verify-environment.mjs",
    "desktop:dev": "scripts\\run-tauri.cmd dev",
    "desktop:build": "scripts\\run-tauri.cmd build",
    "release:check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run build && npm --prefix upgrade run lint && npm --prefix upgrade run build",
    "release:desktop": "npm run build && npm --prefix upgrade run build && npm run desktop:build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.108.2",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-highlight": "latest",
    "@tiptap/extension-image": "latest",
    "@tiptap/extension-link": "latest",
    "@tiptap/extension-table": "latest",
    "@tiptap/extension-text-align": "latest",
    "@tiptap/extension-text-style": "latest",
    "@tiptap/extension-underline": "latest",
    "@tiptap/react": "latest",
    "@tiptap/starter-kit": "latest",
    "clsx": "latest",
    "docx": "^9.7.1",
    "dompurify": "latest",
    "idb-keyval": "latest",
    "jsdom": "^29.1.1",
    "lucide-react": "latest",
    "mammoth": "^1.12.0",
    "nanoid": "latest",
    "next": "latest",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.1",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.2",
    "eslint-config-next": "latest",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.7.0"
}
