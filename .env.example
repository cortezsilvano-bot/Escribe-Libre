# ---------------------------------------------------------------------------
# Escribe Libre
#
# The editor is local-first: with no values set at all, `npm run dev` gives you
# a fully working word processor that stores documents in the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Escribe Libre
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# "mock" keeps every document in IndexedDB and needs nothing below.
# "supabase" enables account-backed sync and requires the Supabase vars.
APP_DATA_MODE=mock

# Auth + cross-device document sync. Only needed when APP_DATA_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
