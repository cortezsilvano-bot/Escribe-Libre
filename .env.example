# ---------------------------------------------------------------------------
# Escribe Libre
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Escribe Libre
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# "mock" runs entirely on local fixtures + IndexedDB and needs nothing below.
# "supabase" enables account-backed sync and requires the Supabase vars.
APP_DATA_MODE=mock

# Auth + cross-device document sync. Local-first storage (idb-keyval) works
# without these; they are only needed when APP_DATA_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Legacy rental-marketplace vars
#
# Not used by the editor. Listed only because marketplace code still present
# in src/ reads them, so removing them here would silently change how those
# routes report themselves. Delete this whole block once the marketplace
# pages, APIs, and lib modules come out of the tree.
# ---------------------------------------------------------------------------
TYPESENSE_HOST=                 # src/app/api/readiness
NEXT_PUBLIC_MAPBOX_TOKEN=       # src/app/api/readiness
RESEND_API_KEY=                 # src/app/api/readiness
QSTASH_CURRENT_SIGNING_KEY=     # src/app/api/jobs/*
ENABLE_RENTCAST=false           # src/lib/providers/listing-source
RENTCAST_API_KEY=
